{
  "name": "nodejs-openhab-test-suite",
  "version": "2.0.0",
  "description": "Tests for openHAB installations in Node.js – same classes and methods as openhab-test-suite (Python). Powered by nodejs-openhab-rest-client.",
  "author": "Michael Christian Dörflinger <michaeldoerflinger93@gmail.com>",
  "license": "MIT",
  "homepage": "https://github.com/Michdo93/nodejs-openhab-test-suite",
  "repository": {
    "type": "git",
    "url": "https://github.com/Michdo93/nodejs-openhab-test-suite.git"
  },
  "keywords": [
    "openhab",
    "smarthome",
    "iot",
    "testing",
    "home-automation",
    "test-suite"
  ],
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/cjs/index.js"
      }
    }
  },
  "types": "./dist/types/index.d.ts",
  "files": [
    "dist/",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "build": "node build.js",
    "test": "node --test test/*.test.mjs",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "nodejs-openhab-rest-client": ">=2.0.0"
  },
  "type": "module",
  "bugs": "https://github.com/Michdo93/nodejs-openhab-test-suite/issues"
}
